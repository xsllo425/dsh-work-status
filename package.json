{
  "name": "dsh-work-status",
  "version": "0.4.13",
  "description": "DeepSeek Harness plugin: one compact row above the composer telling you what the agent is doing, what it finished, and whether anything is stuck. DSH 插件：用最少的注意力看清 agent 的工作状态。",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/activity.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE",
    "scripts/check-manifest.mjs",
    "tests/activity.test.mjs",
    "tests/client-render.test.mjs",
    "tests/semantics.test.mjs",
    "tests/decisions.test.mjs",
    "tests/acp-shapes.test.mjs"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "activity",
    "progress",
    "agent-observability"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "check": "node scripts/check-manifest.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "author": "oxygenforce",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxygenforce/dsh-work-status.git"
  },
  "homepage": "https://github.com/oxygenforce/dsh-work-status#readme",
  "bugs": {
    "url": "https://github.com/oxygenforce/dsh-work-status/issues"
  }
}
